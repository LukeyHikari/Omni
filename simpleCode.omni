~Input Statement
string strInput
read(strInput)

~Output Statements
write(strInput)
write("Hello World")
write("Hello World", strInput)

~Declaration Statements
char a
char b
int c
int d

~Assignment Statements
a = b
c = 1
d = c +1

~Condition Statements
if(c==1){
	write("c is equal to 1")
}

if(d==2){
	write("d is equal to 2")
} 
else{
	write("d is not equal to 2")
}

if(d==1){
	write("d is equal to 1")
} 
else if(d==2){
	write("d is equal to 2")
} 
else{
	write("d is not equal to 1 or 2")
}

~Iterative Statements
int i 
for i in range(1, 5, 1){
	write(i)
}

int j
int k
for j in range(1, 5, 1){
	for j in range(1, 5, 1){
		write(i, j)
	}
}