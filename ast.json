(DECL (int) (counter))
(DECL (decimal) (value))
(DECL (string) (message))
(DECL (char) (symbol))
(DECL (bool) (isActive))
(DECL (int) (userNum))
(DECL (int) (anotherNum))
(DECL (decimal) (circleArea))
(DECL (int) (sampleInt))
(DECL (decimal) (sampleDec))
(DECL (string) (sampleStr))
(DECL (bool) (systemReady))
(DECL (string) (optionalText))
(DECL (int) (range1))
(DECL (int) (range2))
(ASSIGN (counter) (0))
(ASSIGN (value) (3.5))
(ASSIGN (message) ("Hello World"))
(ASSIGN (symbol) ('A'))
(ASSIGN (isActive) (true))
(ASSIGN (userNum) (0))
(ASSIGN (anotherNum) (4))
(ASSIGN (range1) (3))
(ASSIGN (range2) (2))
(ASSIGN (circleArea) ((* (pi) ((^ (2) (2))))))
(ASSIGN (sampleInt) (sInInt))
(ASSIGN (sampleDec) (sInDec))
(ASSIGN (sampleStr) (sInString))
(WRITE ("Constant pi value is") (pi))
(WRITE ("Sample integer is") (sampleInt))
(WRITE ("Sample decimal is") (sampleDec))
(WRITE ("Sample string is") (sampleStr))
(WRITE ("Enter a number"))
(READ (userNum))
(DECL (decimal) (result))
(ASSIGN (result) ((/ ((* ((- ((+ (userNum) (value))) (1))) (2))) (3))))
(DECL (int) (remainder))
(ASSIGN (remainder) ((% (userNum) (anotherNum))))
(DECL (int) (wholeDiv))
(ASSIGN (wholeDiv) ((DIV (userNum) (anotherNum))))
(DECL (decimal) (power))
(ASSIGN (power) ((^ (2) (3))))
(WRITE ("Result:") (result))
(WRITE ("Modulus:") (remainder))
(WRITE ("Integer Division:") (wholeDiv))
(WRITE ("Exponentiation:") (power))
(IF_STMT (== (result) (10)) (BLOCK (WRITE ("Result is exactly 10"))) (ELSE (BLOCK (WRITE ("Result is not 10")))))
(IF_STMT (or ((and ((> (userNum) (0))) ((== (isActive) (true))))) ((!= (result) (0)))) (BLOCK (WRITE ("Complex condition evaluated to true"))))
(IF_STMT (> (result) (20)) (BLOCK (WRITE ("Result is NOT greater than 20"))))
(ASSIGN (systemReady) (false))
(ASSIGN (optionalText) (null))
(IF_STMT (== (systemReady) (false)) (BLOCK (WRITE ("System is not ready"))))
(FOR_STMT i (RANGE range1) (BLOCK (WRITE ("Outer loop i") (i)) (FOR_STMT j (RANGE range2) (BLOCK (WRITE ("Inner loop j") (j))))))
(IF_STMT (!= (symbol) ('Z')) (BLOCK (WRITE ("Symbol is not Z"))))
(WRITE ("Program Finished"))
